diff --git a/Makefile b/Makefile
index 9d94c10..44c86cb 100644
--- a/Makefile
+++ b/Makefile
@@ -11,7 +11,7 @@ TARGET ?= iphone:clang:16.5:9.0
 # The lane matrix itself lives in $THEOS/bin/lane.sh, shared with Shadow so the
 # two cannot drift on architectures, pinned SDK or packaging scheme.
 ifneq ($(HOOKKIT_LANE),)
-_HK_LANE := $(THEOS)/bin/lane.sh get $(HOOKKIT_LANE)
+_HK_LANE := bash "$(CURDIR)/build-support/shadow/hookkit-lanes.sh" get $(HOOKKIT_LANE)
 override ARCHS := $(shell $(_HK_LANE) ARCHS)
 override TARGET := $(shell $(_HK_LANE) TARGET)
 override THEOS_PACKAGE_SCHEME := $(shell $(_HK_LANE) SCHEME)
diff --git a/build.sh b/build.sh
index 9b23c23..11e5649 100755
--- a/build.sh
+++ b/build.sh
@@ -24,7 +24,7 @@ run_make() {
 # arm64e slices with the versioned ptrauth ABI (cpusubtype 0x80000002); theos's
 # bundled clang emits 0x00000002, which modern ld rejects as "arm64e.old".
 # $THEOS/bin/setup-modern-toolchain.sh assembles one that can.
-. "$THEOS/bin/lane.sh"
+. "$ROOT/build-support/shadow/hookkit-lanes.sh"

 require_modern_toolchain() { theos_abi_require new "$1"; }
 require_oldabi_toolchain()  { theos_abi_require old rootful-legacy; }

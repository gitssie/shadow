+/* Read-only adapter state: valid before the TLS filter becomes connected. */
+CURLcode Curl_ossl_shadow_io_state(struct connectdata *connection,
+                                   int *io_need, int *shutdown_state)
+{
+  struct Curl_cfilter *cf;
+  struct ssl_connect_data *connssl;
+  struct ossl_ctx *octx;
+  int shutdown_bits;
+  if(!connection || !io_need || !shutdown_state)
+    return CURLE_BAD_FUNCTION_ARGUMENT;
+  *io_need = *shutdown_state = 0;
+  for(cf = connection->cfilter[FIRSTSOCKET]; cf; cf = cf->next) {
+    if(cf->cft == &Curl_cft_ssl)
+      break;
+  }
+  if(!cf || !cf->ctx)
+    return CURLE_UNSUPPORTED_PROTOCOL;
+  connssl = cf->ctx;
+  if(connssl->ssl_impl != &Curl_ssl_openssl)
+    return CURLE_NOT_BUILT_IN;
+  octx = connssl->backend;
+  if(!octx || !octx->ssl)
+    return CURLE_SSL_CONNECT_ERROR;
+  if(connssl->io_need & CURL_SSL_IO_NEED_RECV)
+    *io_need |= 1;
+  if(connssl->io_need & CURL_SSL_IO_NEED_SEND)
+    *io_need |= 2;
+  shutdown_bits = SSL_get_shutdown(octx->ssl);
+  if(shutdown_bits & SSL_SENT_SHUTDOWN)
+    *shutdown_state |= 1;
+  if(shutdown_bits & SSL_RECEIVED_SHUTDOWN)
+    *shutdown_state |= 2;
+  return CURLE_OK;
+}
+
+CURLcode Curl_ossl_shadow_shutdown_write(struct Curl_easy *data,
+                                        struct connectdata *connection)
+{
+  struct Curl_cfilter *cf;
+  struct cf_call_data save;
+  struct ssl_connect_data *connssl;
+  struct ossl_ctx *octx;
+  int rc, error;
+  CURLcode result;
+  for(cf = connection->cfilter[FIRSTSOCKET]; cf; cf = cf->next) {
+    if(cf->cft == &Curl_cft_ssl)
+      break;
+  }
+  if(!cf || !cf->connected)
+    return CURLE_UNSUPPORTED_PROTOCOL;
+  connssl = cf->ctx;
+  if(connssl->ssl_impl != &Curl_ssl_openssl)
+    return CURLE_NOT_BUILT_IN;
+  octx = connssl->backend;
+  if(!octx || !octx->ssl)
+    return CURLE_SSL_CONNECT_ERROR;
+  connssl->io_need = CURL_SSL_IO_NEED_NONE;
+  CF_DATA_SAVE(save, cf, data);
+  if(!SSL_is_init_finished(octx->ssl)) {
+    unsigned char pending;
+    ERR_clear_error();
+    rc = SSL_peek(octx->ssl, &pending, 1);
+    error = rc <= 0 ? SSL_get_error(octx->ssl, rc) : SSL_ERROR_NONE;
+    if(error != SSL_ERROR_NONE && error != SSL_ERROR_WANT_READ &&
+       error != SSL_ERROR_WANT_WRITE) {
+      CF_DATA_RESTORE(cf, save);
+      return CURLE_SEND_ERROR;
+    }
+    if(error == SSL_ERROR_WANT_READ)
+      connssl->io_need = CURL_SSL_IO_NEED_RECV;
+    else if(error == SSL_ERROR_WANT_WRITE)
+      connssl->io_need = CURL_SSL_IO_NEED_SEND;
+    if(!SSL_is_init_finished(octx->ssl)) {
+      CF_DATA_RESTORE(cf, save);
+      return CURLE_AGAIN;
+    }
+  }
+  if(octx->shadow_write_shutdown_complete)
+    result = CURLE_OK;
+  else {
+    ERR_clear_error();
+    rc = SSL_shutdown(octx->ssl);
+    error = rc < 0 ? SSL_get_error(octx->ssl, rc) : SSL_ERROR_NONE;
+    if(error == SSL_ERROR_WANT_READ || error == SSL_ERROR_WANT_WRITE) {
+      connssl->io_need = error == SSL_ERROR_WANT_READ ?
+        CURL_SSL_IO_NEED_RECV : CURL_SSL_IO_NEED_SEND;
+      result = CURLE_AGAIN;
+    }
+    else if(rc >= 0 && (SSL_get_shutdown(octx->ssl) & SSL_SENT_SHUTDOWN)) {
+      octx->shadow_write_shutdown_complete = TRUE;
+      result = CURLE_OK;
+    }
+    else
+      result = CURLE_SEND_ERROR;
+  }
+  CF_DATA_RESTORE(cf, save);
+  return result;
+}
+
+/* Internal experimental adapter. Certificate bytes live for the callback. */
+CURLcode Curl_ossl_shadow_tls_snapshot(void *internals,
+                                      unsigned int *version,
+                                      unsigned int *cipher,
+                                      int (*certificate)(const unsigned char *,
+                                                         size_t, void *),
+                                      void *context, bool finalized)
+{
+  SSL *ssl = internals;
+  const SSL_CIPHER *selected;
+  STACK_OF(X509) *chain;
+  size_t i, count;
+  if(!ssl || !version || !cipher || !certificate)
+    return CURLE_BAD_FUNCTION_ARGUMENT;
+  selected = SSL_get_current_cipher(ssl);
+  chain = SSL_get_peer_cert_chain(ssl);
+  count = chain ? sk_X509_num(chain) : 0;
+  if(!selected || !count ||
+     (finalized && !SSL_is_init_finished(ssl) && !SSL_in_false_start(ssl)))
+    return CURLE_SSL_CONNECT_ERROR;
+  *version = (unsigned int)SSL_version(ssl);
+  *cipher = (unsigned int)(SSL_CIPHER_get_id(selected) & 0xffff);
+  for(i = 0; i < count; ++i) {
+    unsigned char *der = NULL;
+    int length = i2d_X509(sk_X509_value(chain, i), &der);
+    int accepted;
+    if(length <= 0 || !der) {
+      OPENSSL_free(der);
+      return CURLE_SSL_CERTPROBLEM;
+    }
+    accepted = certificate(der, (size_t)length, context);
+    OPENSSL_free(der);
+    if(!accepted)
+      return CURLE_ABORTED_BY_CALLBACK;
+  }
+  return CURLE_OK;
+}
+
+CURLcode Curl_ossl_shadow_verification_snapshot(
+  void *internals, char *alpn, size_t capacity,
+  unsigned int *version, unsigned int *cipher,
+  int (*certificate)(const unsigned char *, size_t, void *), void *context)
+{
+  const uint8_t *selected = NULL;
+  unsigned int length = 0;
+  SSL *ssl = internals;
+  if(!ssl || !alpn || !capacity)
+    return CURLE_BAD_FUNCTION_ARGUMENT;
+  SSL_get0_alpn_selected(ssl, &selected, &length);
+  if(length >= capacity)
+    return CURLE_BAD_FUNCTION_ARGUMENT;
+  if(length)
+    memcpy(alpn, selected, length);
+  alpn[length] = 0;
+  return Curl_ossl_shadow_tls_snapshot(ssl, version, cipher,
+                                       certificate, context, FALSE);
+}

+/* The native owner supplies an already established byte stream. No socket,
+   resolver, proxy, or polling ownership crosses this boundary. */
+struct shadow_transport {
+  CURLcode (*read_cb)(void *, void *, size_t, size_t *);
+  CURLcode (*write_cb)(void *, const void *, size_t, size_t *);
+  void *context;
+};
+
+static void shadow_transport_destroy(struct Curl_cfilter *cf,
+                                       struct Curl_easy *data)
+{
+  (void)data;
+  free(cf->ctx);
+  cf->ctx = NULL;
+}
+
+static CURLcode shadow_transport_connect(struct Curl_cfilter *cf,
+                                          struct Curl_easy *data, bool *done)
+{
+  (void)data;
+  cf->connected = TRUE;
+  *done = TRUE;
+  return CURLE_OK;
+}
+
+static CURLcode shadow_transport_pollset(struct Curl_cfilter *cf,
+                                          struct Curl_easy *data,
+                                          struct easy_pollset *ps)
+{
+  (void)cf;
+  (void)data;
+  (void)ps;
+  return CURLE_OK;
+}
+
+static CURLcode shadow_transport_send(struct Curl_cfilter *cf,
+                                       struct Curl_easy *data,
+                                       const uint8_t *buf, size_t len,
+                                       bool eos, size_t *n)
+{
+  struct shadow_transport *ctx = cf->ctx;
+  CURLcode result;
+  (void)data;
+  (void)eos;
+  *n = 0;
+  result = ctx->write_cb(ctx->context, buf, len, n);
+  if(*n > len || (result && *n)) {
+    *n = 0;
+    return CURLE_SEND_ERROR;
+  }
+  return result;
+}
+
+static CURLcode shadow_transport_recv(struct Curl_cfilter *cf,
+                                       struct Curl_easy *data, char *buf,
+                                       size_t len, size_t *n)
+{
+  struct shadow_transport *ctx = cf->ctx;
+  CURLcode result;
+  (void)data;
+  *n = 0;
+  result = ctx->read_cb(ctx->context, buf, len, n);
+  if(*n > len || (result && *n)) {
+    *n = 0;
+    return CURLE_RECV_ERROR;
+  }
+  return result;
+}
+
+static bool shadow_transport_alive(struct Curl_cfilter *cf,
+                                    struct Curl_easy *data, bool *pending)
+{
+  (void)data;
+  *pending = FALSE;
+  return cf->connected;
+}

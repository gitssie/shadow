+    memset(res2, 0, sizeof(struct ip_quadruple));
+    return CURLE_OK;
+  }
+  if(query == CF_QUERY_REMOTE_ADDR) {
+    *(const struct Curl_sockaddr_ex **)res2 = NULL;
+    return CURLE_OK;
+  }
+  if(query == CF_QUERY_CONNECT_REPLY_MS) {
+    *res1 = -1;
+    return CURLE_OK;
+  }
+  if(query == CF_QUERY_SOCKET) {
